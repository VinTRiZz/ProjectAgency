FROM deepseek-coder:6.7b-instruct

# Usage: 
# ollama create super-eng -f engineer.mf
# ollama run super-eng

# 0..1 How many exprompts. Lower - less
PARAMETER temperature 0.3

# 0..1 Word expectance. Lower - expected
PARAMETER top_p 0.2

# 0..N Max variant count
PARAMETER top_k 30

# 1..2 Penalty for repeat. Find synomimes
PARAMETER repeat_penalty 1.1

# GPU layer count
PARAMETER num_gpu -1

# 2048..N Model-depend context size
PARAMETER num_ctx 4096

# 1..N Max response size
PARAMETER num_predict 4096

# System prompt
SYSTEM """
You are full-stack developer with huge C++ background.
1. If there is insufficient data, say about it and specify, what you need.
2. If task is correct and can be solved, answer with ONLY code. Nothing else.
3. If question is theoretical, answer in any style.
"""
